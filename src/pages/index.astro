---
import Layout from '../layouts/Layout.astro';
import Cover from '../components/Cover.astro';
import Countdown from '../components/Countdown.astro';
import Calendar from '../components/Calendar.astro';
import RsvpSection from '../components/RsvpSection.astro';
import Ornament from '../components/Ornament.astro';
import MusicToggle from '../components/MusicToggle.astro';
import Grass from '../components/Grass.astro';
import ScrollHint from '../components/ScrollHint.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const img = (p: string) => `${base}/img/${p}`;

const mapsUrl = 'https://maps.app.goo.gl/T767ntdpDxXdz9Q57';
const calendarUrl =
	'https://calendar.google.com/calendar/render?action=TEMPLATE' +
	'&text=' + encodeURIComponent('Cumpleaños de Emma Esmeralda · 2 añitos 🍎') +
	'&dates=20261129T210000Z/20261130T010000Z' +
	'&details=' + encodeURIComponent('Fiesta de Blanca Nieves por los 2 añitos de Emma Esmeralda.') +
	'&location=' + encodeURIComponent('Crystal Palace Cusco, Av. Tomasa Titto Condemayta 1834, Cusco');

// Partículas mágicas de fondo (deterministas para que el HTML sea estable)
const particles = Array.from({ length: 18 }, (_, i) => ({
	kind: (['apple', 'leaf', 'sparkle'] as const)[i % 3],
	left: (i * 41 + 7) % 100,
	delay: -((i * 1.7) % 14).toFixed(1),
	dur: 12 + ((i * 3) % 9),
	size: 12 + ((i * 5) % 12),
}));
---

<Layout>
	<Cover />
	<MusicToggle />
	<ScrollHint />

	<div class="magic-rain" aria-hidden="true">
		{particles.map((p) => (
			<span class={`rain-item rain-${p.kind}`} style={`left:${p.left}%;animation-delay:${p.delay}s;animation-duration:${p.dur}s`}>
				<Ornament variant={p.kind} size={p.size} />
			</span>
		))}
	</div>

	<main class="storybook">
		<article class="story-card">

			<!-- ═════════ CAPÍTULO I · HABÍA UNA VEZ ═════════ -->
			<section class="chapter chapter-light chapter-hero" aria-labelledby="ch1-title">
				<div class="clouds" aria-hidden="true">
					<span class="cloud cloud-1"></span>
					<span class="cloud cloud-2"></span>
					<span class="cloud cloud-3"></span>
				</div>

				<div class="flying-birds" aria-hidden="true">
					<span class="flyer flyer-1"><Ornament variant="bird" size={38} /></span>
					<span class="flyer flyer-2"><Ornament variant="bird" size={28} /></span>
				</div>

				<div class="chapter-badge reveal" data-reveal="zoom"><span>Capítulo I</span></div>
				<h2 class="chapter-title reveal" id="ch1-title">Había una vez…</h2>

				<p class="story-text drop-cap reveal">
					En un reino muy, muy cercano, entre montañas y bosques encantados, una pequeña princesa
					de mejillas rosadas y risa de campanita. Los pajaritos cantaban al verla pasar y las flores
					se abrían solo para saludarla.
				</p>

				<div class="hero-figure reveal" data-reveal="zoom">
					<span class="hero-halo" aria-hidden="true"></span>
					<Ornament variant="sparkle" size={22} class="tw tw-1" />
					<Ornament variant="sparkle" size={14} class="tw tw-2" />
					<Ornament variant="sparkle" size={18} class="tw tw-3" />
					<div class="hero-art float-slow">
						<img src={img('elements/blancanieves-2.webp')} alt="Blanca Nieves bebé lanzando un besito junto a un gran número 2 dorado con corona" width="900" height="971" loading="eager" />
						<span class="plaque-name">Emma</span>
					</div>
				</div>

				<p class="story-text center reveal">Su nombre era…</p>
				<h1 class="princess-name reveal" data-reveal="zoom">
					<span class="pn-first">Emma</span>
					<span class="pn-second">Esmeralda</span>
				</h1>
				<p class="story-text center reveal">
					y estaba a punto de cumplir sus primeros
				</p>
				<p class="age-badge reveal" data-reveal="zoom">
					<span class="age-num">2</span>
					<span class="age-word">añitos</span>
				</p>

				<div class="reveal w-full"><Ornament variant="divider" /></div>
				<Grass />
			</section>

			<!-- ═════════ CAPÍTULO II · ESPEJITO, ESPEJITO ═════════ -->
			<section class="chapter chapter-dark" aria-labelledby="ch2-title">

				<div class="chapter-badge reveal" data-reveal="zoom"><span>Capítulo II</span></div>
				<h2 class="chapter-title reveal" id="ch2-title">Espejito, espejito</h2>

				<p class="story-text reveal">
					En lo alto del castillo había un espejo mágico que todo lo sabía. Una tarde, alguien
					se acercó y le preguntó en voz bajita:
				</p>

				<blockquote class="dialogue reveal">
					—Espejito, espejito mágico, ¿quién es la princesita más dulce de todo el reino?
				</blockquote>

				<div class="mirror reveal" data-reveal="zoom">
					<div class="mirror-photo">
						<img src={img('emma-espejo.webp')} alt="Emma Esmeralda" width="1000" height="1275" loading="lazy" />
						<span class="mirror-shine" aria-hidden="true"></span>
					</div>
					<img class="mirror-frame" src={img('elements/espejo.webp')} alt="" width="900" height="1342" loading="lazy" />
					<span class="mirror-glow" aria-hidden="true"></span>
				</div>

				<p class="mirror-answer" id="mirror-answer" data-text="—Es Emma Esmeralda, que este domingo cumple 2 añitos y quiere celebrarlo contigo.">
					<span class="typed" aria-hidden="true"></span><span class="caret" aria-hidden="true"></span>
					<span class="sr-only">—Es Emma Esmeralda, que este domingo cumple 2 añitos y quiere celebrarlo contigo.</span>
				</p>
			</section>

			<!-- ═════════ CAPÍTULO III · EL GRAN DÍA ═════════ -->
			<section class="chapter chapter-light chapter-day" aria-labelledby="ch3-title">
				<div class="wave wave-top wave-from-dark" aria-hidden="true"></div>

				<div class="chapter-badge reveal" data-reveal="zoom"><span>Capítulo III</span></div>
				<h2 class="chapter-title reveal" id="ch3-title">El gran día</h2>

				<p class="story-text reveal">
					Los pajaritos azules volaron a cada rincón del bosque llevando la noticia: ¡habría una
					gran fiesta en el reino! Y el día elegido fue…
				</p>

				<div class="date-scroll reveal" data-reveal="zoom">
					<span class="ds-side">Domingo</span>
					<span class="ds-day">29</span>
					<span class="ds-side">Noviembre</span>
					<span class="ds-year">2026</span>
					<span class="ds-time">
						<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" stroke-linecap="round" /></svg>
						4:00 p.m.
					</span>
				</div>

				<div class="reveal w-full"><Countdown targetDate="2026-11-29T16:00:00-05:00" /></div>

				<div class="reveal w-full" data-reveal="up"><Calendar /></div>

				<a class="btn btn-blue reveal" href={calendarUrl} target="_blank" rel="noopener noreferrer">
					<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 10h18M8 3v4M16 3v4M12 13v5M9.5 15.5h5" stroke-linecap="round" /></svg>
					<span>Agendar en mi calendario</span>
				</a>
			</section>

			<!-- ═════════ CAPÍTULO IV · LA CASITA DEL BOSQUE ═════════ -->
			<section class="chapter chapter-forest" aria-labelledby="ch4-title">
				<div class="chapter-badge reveal" data-reveal="zoom"><span>Capítulo IV</span></div>
				<h2 class="chapter-title reveal" id="ch4-title">Rumbo al palacio</h2>

				<p class="story-text reveal">
					Los enanitos dejaron sus picos y palas, y junto a los animalitos del bosque se pusieron
					a decorar el lugar más brillante del reino: un palacio de cristal donde la magia
					estaría esperando por ti.
				</p>

				<div class="cottage reveal" data-reveal="up">
					<img src={img('elements/enanos.webp')} alt="Los enanitos frente a su casita en el bosque, rodeados de manzanos" width="1000" height="960" loading="lazy" />
					<Ornament variant="sparkle" size={16} class="tw tw-4" />
					<Ornament variant="sparkle" size={12} class="tw tw-5" />
				</div>

				<div class="place-card reveal" data-reveal="up">
					<div class="place-icon" aria-hidden="true">
						<Ornament variant="crown" size={34} />
					</div>
					<p class="place-kicker">El reino se reúne en</p>
					<h3 class="place-name">Crystal Palace</h3>
					<p class="place-city">Cusco</p>
					<p class="place-address">Av. Tomasa Titto Condemayta 1834</p>
					<p class="place-time">Desde las <strong>4:00 p.m.</strong></p>
					<a class="btn btn-red" href={mapsUrl} target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" /></svg>
						<span>Ver el camino en el mapa</span>
					</a>
				</div>

				<div class="theme-note reveal">
					<Ornament variant="leaf" size={18} />
					<p>Temática: <strong>Blanca Nieves</strong>, los enanitos y los animalitos del bosque</p>
					<Ornament variant="apple" size={18} />
				</div>
				<Grass />
			</section>

			<!-- ═════════ CAPÍTULO V · UNA INVITACIÓN REAL ═════════ -->
			<section class="chapter chapter-dark chapter-rsvp" aria-labelledby="ch5-title">

				<div class="chapter-badge reveal" data-reveal="zoom"><span>Capítulo V</span></div>
				<h2 class="chapter-title reveal" id="ch5-title">Una invitación real</h2>

				<div class="orchard reveal" data-reveal="zoom">
					<img src={img('elements/manzanar.webp')} alt="Blanca Nieves bebé sentada en el manzanar junto a una canasta de manzanas" width="1000" height="1339" loading="lazy" />
				</div>

				<p class="story-text reveal">
					Toda princesa sabe que una fiesta no es igual sin sus invitados especiales. Por eso Emma
					guardó una manzana —¡de las buenas, sin hechizos!— solo para ti.
				</p>
				<p class="story-text strong reveal">Confirma tu llegada al reino ✨</p>

				<div class="reveal w-full" data-reveal="up"><RsvpSection /></div>
			</section>

			<!-- ═════════ EPÍLOGO · Y VIVIERON FELICES ═════════ -->
			<section class="chapter chapter-epilogue" aria-labelledby="ch6-title">
				<div class="reveal" data-reveal="zoom"><Ornament variant="crown" size={56} class="epi-crown" /></div>
				<h2 class="epi-title reveal" id="ch6-title">¡Te esperamos!</h2>
				<p class="story-text center reveal">
					…y todos celebraron juntos, entre risas, manzanas y mucha magia, y vivieron felices
					para siempre.
				</p>
				<p class="epi-date reveal">29 · 11 · 2026 · Cusco</p>
				<div class="reveal w-full"><Ornament variant="divider" /></div>
				<p class="epi-fin reveal" data-reveal="zoom">Fin</p>
				<p class="epi-sign reveal">Con cariño, la familia de Emma</p>
				<Grass variant="night" />
			</section>

			<!-- ═════════ FOOTER · CONTACTO ═════════ -->
			<footer class="event-footer">
				<div class="footer-content reveal">
					<h3 class="footer-question">
						¿Quieres hacer tus invitaciones para un evento?
					</h3>

					<p class="footer-subtitle">
						Diseñamos invitaciones digitales interactivas, elegantes y memorables para bodas, quinceañeros y eventos especiales.
					</p>

					<div class="footer-btn-wrapper">
						<a
							href="https://api.whatsapp.com/send?phone=51914094578&text=%C2%A1Hola!%20Deseo%20informaci%C3%B3n%20para%20crear%20una%20invitaci%C3%B3n%20para%20mi%20evento."
							target="_blank"
							rel="noopener noreferrer"
							class="footer-contact-btn"
						>
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
							</svg>
							Contáctanos
						</a>
					</div>

					<div class="footer-copyright">
						<span>Invitard &copy; {new Date().getFullYear()}</span>
					</div>
				</div>
			</footer>
		</article>
	</main>
</Layout>

<style>
	/* ───── Lluvia mágica de fondo ───── */
	.magic-rain {
		position: fixed;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		z-index: 0;
	}

	.rain-item {
		position: absolute;
		top: -40px;
		animation-name: rain-fall;
		animation-timing-function: linear;
		animation-iteration-count: infinite;
		opacity: 0.75;
	}

	.rain-sparkle {
		color: #f6d77a;
	}

	@keyframes rain-fall {
		0% { transform: translate3d(0, -5vh, 0) rotate(0deg); }
		25% { transform: translate3d(22px, 25vh, 0) rotate(90deg); }
		50% { transform: translate3d(-14px, 55vh, 0) rotate(180deg); }
		75% { transform: translate3d(18px, 82vh, 0) rotate(270deg); }
		100% { transform: translate3d(0, 110vh, 0) rotate(360deg); }
	}

	/* ───── Libro / tarjeta ───── */
	.storybook {
		position: relative;
		z-index: 1;
		display: flex;
		justify-content: center;
		padding: 14px 10px 40px;
	}

	.story-card {
		width: 100%;
		max-width: 480px;
		border-radius: 28px;
		overflow: hidden;
		background: var(--blue-50);
		box-shadow:
			0 30px 60px rgba(0, 0, 0, 0.45),
			0 0 0 2px rgba(217, 169, 58, 0.55),
			0 0 0 7px rgba(29, 71, 161, 0.6),
			0 0 0 8px rgba(217, 169, 58, 0.4);
	}

	/* ───── Capítulos ───── */
	.chapter {
		position: relative;
		padding: 56px 22px 52px;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
	}

	.chapter-light {
		background:
			radial-gradient(circle at 15% 10%, rgba(255, 255, 255, 0.9) 0, transparent 35%),
			linear-gradient(180deg, var(--blue-100) 0%, var(--blue-50) 55%, #eef8f1 82%, #c6e8d0 100%);
	}

	.chapter-light,
	.chapter-forest,
	.chapter-epilogue {
		padding-bottom: 116px;
	}

	/* El gran día: sin césped, se funde en verde con el capítulo siguiente */
	.chapter-light.chapter-day {
		padding-bottom: 30px;
		background:
			radial-gradient(circle at 15% 10%, rgba(255, 255, 255, 0.9) 0, transparent 35%),
			linear-gradient(180deg, var(--blue-100) 0%, var(--blue-50) 45%, #eef8f1 75%, #d6efdd 100%);
	}

	.chapter-hero {
		padding-top: 64px;
		overflow: hidden;
	}

	.chapter-dark {
		color: #fff;
		background:
			radial-gradient(ellipse at 50% 35%, rgba(107, 155, 230, 0.35) 0%, transparent 55%),
			linear-gradient(180deg, var(--blue-800) 0%, var(--blue-900) 100%);
		padding-top: 60px;
	}

	.w-full {
		width: 100%;
	}

	.chapter-forest {
		padding-top: 30px;
		background:
			radial-gradient(ellipse at 50% 100%, rgba(95, 191, 125, 0.45) 0%, transparent 60%),
			linear-gradient(180deg, #d6efdd 0%, #def3e4 35%, #cdebd6 65%, #b9e3c6 100%);
	}

	.chapter-epilogue {
		color: #fff;
		background:
			radial-gradient(circle at 50% 210px, rgba(246, 215, 122, 0.16) 0, transparent 190px),
			linear-gradient(180deg, var(--blue-900) 0%, #0f3350 22%, #134a45 48%, #1a5e3c 72%, var(--green-700) 100%);
	}

	/* Olas festoneadas entre capítulos */
	.wave {
		position: absolute;
		left: 0;
		right: 0;
		height: 28px;
		top: -1px;
		background: radial-gradient(circle at 50% 0, var(--wave-color, #fff) 70%, transparent 71%) 0 0 / 36px 28px repeat-x;
	}

	.wave-from-dark {
		--wave-color: var(--blue-900);
	}

	/* Insignia de capítulo: listón rojo con letras doradas */
	.chapter-badge {
		position: relative;
		display: inline-block;
		padding: 5px 28px 6px;
		background: linear-gradient(180deg, var(--red-600), var(--red-700));
		color: #fff1bf;
		font-family: var(--font-story);
		font-weight: 700;
		font-size: 15px;
		letter-spacing: 3px;
		text-transform: uppercase;
		box-shadow: 0 6px 14px rgba(154, 20, 36, 0.35);
		clip-path: polygon(0 0, 100% 0, 94% 50%, 100% 100%, 0 100%, 6% 50%);
	}

	.chapter-badge span {
		position: relative;
	}

	.chapter-title {
		font-family: var(--font-script);
		font-weight: 400;
		font-size: clamp(44px, 12vw, 56px);
		line-height: 1;
		color: var(--blue-700);
		margin-top: -4px;
	}

	.chapter-dark .chapter-title,
	.epi-title {
		background: var(--gold-gradient);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		animation: shimmer 5s linear infinite;
	}

	.story-text {
		font-family: var(--font-story);
		font-size: 19px;
		line-height: 1.55;
		font-weight: 500;
		color: var(--ink-soft);
		max-width: 380px;
		text-align: left;
	}

	.story-text.center {
		text-align: center;
	}

	.story-text.strong {
		font-weight: 700;
		text-align: center;
	}

	.chapter-dark .story-text,
	.chapter-epilogue .story-text {
		color: var(--blue-100);
	}

	.drop-cap::first-letter {
		float: left;
		font-family: var(--font-deco);
		font-weight: 900;
		font-size: 58px;
		line-height: 0.85;
		padding: 6px 8px 0 0;
		color: var(--red-600);
		text-shadow: 2px 2px 0 rgba(217, 169, 58, 0.5);
	}

	/* ───── Capítulo I ───── */
	.clouds {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.cloud {
		position: absolute;
		width: 90px;
		height: 28px;
		border-radius: 999px;
		background: #fff;
		opacity: 0.85;
		filter: blur(0.5px);
		animation: cloud-drift 28s linear infinite;
	}

	.cloud::before,
	.cloud::after {
		content: '';
		position: absolute;
		background: #fff;
		border-radius: 50%;
	}

	.cloud::before { width: 40px; height: 40px; left: 14px; top: -20px; }
	.cloud::after { width: 30px; height: 30px; left: 46px; top: -14px; }
	.cloud-1 { top: 22px; left: -100px; }
	.cloud-2 { top: 110px; left: -100px; transform: scale(0.7); animation-duration: 36s; animation-delay: -14s; }
	.cloud-3 { top: 420px; left: -100px; transform: scale(0.55); animation-duration: 42s; animation-delay: -24s; opacity: 0.6; }

	@keyframes cloud-drift {
		from { translate: 0 0; }
		to { translate: 620px 0; }
	}

	.flying-birds {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.flyer {
		position: absolute;
		left: -60px;
		animation: fly-across 14s linear infinite;
	}

	.flyer-1 { top: 150px; }
	.flyer-2 { top: 190px; animation-delay: -5s; animation-duration: 17s; }

	@keyframes fly-across {
		0% { transform: translate(0, 0); }
		25% { transform: translate(140px, -24px); }
		50% { transform: translate(280px, 8px); }
		75% { transform: translate(420px, -18px); }
		100% { transform: translate(600px, 0); }
	}

	.hero-figure {
		position: relative;
		width: min(100%, 360px);
		margin: 4px auto -4px;
	}

	.hero-halo {
		position: absolute;
		inset: 6% 2% 2%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(107, 155, 230, 0.45) 0%, rgba(207, 224, 251, 0.3) 45%, transparent 70%);
		animation: halo 4s ease-in-out infinite;
	}

	.hero-art {
		position: relative;
		container-type: inline-size;
	}

	.hero-art img {
		width: 100%;
		height: auto;
		filter: drop-shadow(0 16px 22px rgba(11, 31, 77, 0.28));
	}

	.plaque-name {
		position: absolute;
		left: 64.5%;
		top: 80.5%;
		transform: translate(-50%, -50%) rotate(-3deg);
		font-family: var(--font-script);
		font-size: 15cqw;
		line-height: 1;
		white-space: nowrap;
		background: var(--gold-gradient);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 2px 2px rgba(80, 0, 10, 0.55));
		animation: shimmer 4s linear infinite;
	}

	:global(.tw) {
		position: absolute;
		color: var(--gold);
		z-index: 2;
		animation: twinkle 2.6s ease-in-out infinite;
	}

	:global(.tw-1) { top: 6%; left: 2%; }
	:global(.tw-2) { top: 30%; right: 2%; animation-delay: 0.8s; }

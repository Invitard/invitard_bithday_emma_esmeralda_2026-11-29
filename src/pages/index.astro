	/* Destellos al tocar */
	:global(.tap-spark) {
		position: fixed;
		z-index: 200;
		width: 12px;
		height: 12px;
		pointer-events: none;
		background: radial-gradient(circle, #fff 0%, #f6d77a 40%, transparent 70%);
		border-radius: 50%;
		animation: tap-spark 0.8s var(--ease-out) forwards;
	}

	@keyframes tap-spark {
		from { transform: translate(-50%, -50%) scale(1); opacity: 1; }
		to { transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy))) scale(0.2); opacity: 0; }
	}
</style>

<script>
	const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// 1. Revelado escalonado al hacer scroll
	const revealObserver = new IntersectionObserver(
		(entries) => {
			entries.forEach((entry) => {
				if (!entry.isIntersecting) return;
				entry.target.classList.add('is-visible');
				revealObserver.unobserve(entry.target);
			});
		},
		{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
	);

	const startReveal = () => {
		document.querySelectorAll<HTMLElement>('.chapter, .event-footer').forEach((chapter) => {
			chapter.querySelectorAll<HTMLElement>('.reveal').forEach((el, i) => {
				el.style.transitionDelay = `${Math.min(i, 3) * 90}ms`;
				revealObserver.observe(el);
			});
		});
	};

	// 2. El espejo responde (efecto máquina de escribir)
	const answer = document.getElementById('mirror-answer');
	const typed = answer?.querySelector<HTMLElement>('.typed');
	if (answer && typed) {
		const text = answer.dataset.text ?? '';
		const mirrorObserver = new IntersectionObserver(
			(entries) => {
				if (!entries[0].isIntersecting) return;
				mirrorObserver.disconnect();
				if (prefersReduced) {
					typed.textContent = text;
					answer.classList.add('is-done');
					return;
				}
				let i = 0;
				const step = () => {
					typed.textContent = text.slice(0, ++i);
					if (i < text.length) window.setTimeout(step, text[i - 1] === ',' ? 260 : 42);
					else answer.classList.add('is-done');
				};
				window.setTimeout(step, 700);
			},
			{ threshold: 0.6 }
		);
		mirrorObserver.observe(answer);
	}

	// 3. Polvo de hadas al tocar la pantalla
	if (!prefersReduced) {
		const colors = ['#f6d77a', '#6b9be6', '#e8505c', '#5fbf7d'];
		window.addEventListener(
			'pointerdown',
			(e) => {
				for (let i = 0; i < 8; i++) {
					const s = document.createElement('span');
					s.className = 'tap-spark';
					const angle = (Math.PI * 2 * i) / 8 + Math.random() * 0.5;
					const dist = 26 + Math.random() * 30;
					s.style.left = `${e.clientX}px`;
					s.style.top = `${e.clientY}px`;
					s.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
					s.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
					s.style.background = `radial-gradient(circle, #fff 0%, ${colors[i % colors.length]} 45%, transparent 70%)`;
					document.body.appendChild(s);
					s.addEventListener('animationend', () => s.remove());
				}
			},
			{ passive: true }
		);
	}

	// Empieza a revelar cuando se abre el libro (o de inmediato si no hay portada)
	if (document.getElementById('story-cover')) {
		document.addEventListener('story:open', startReveal, { once: true });
	} else {
		startReveal();
	}
</script>

---
// Countdown.astro — cuenta regresiva en "pergaminos" mágicos
interface Props {
	targetDate: string;
}

const { targetDate } = Astro.props;
const units = [
	{ id: 'days', label: 'Días', color: 'blue' },
	{ id: 'hours', label: 'Horas', color: 'red' },
	{ id: 'minutes', label: 'Min', color: 'green' },
	{ id: 'seconds', label: 'Seg', color: 'blue' },
];
---

<div class="countdown" id="countdown" data-target={targetDate}>
	<p class="countdown-title">Faltan para la fiesta</p>
	<div class="countdown-grid">
		{units.map((u) => (
			<div class={`cd-box cd-${u.color}`}>
				<span class="cd-val" data-unit={u.id}>00</span>
				<span class="cd-label">{u.label}</span>
			</div>
		))}
	</div>
	<p class="countdown-done" hidden>¡Hoy es el gran día! ✨</p>
</div>

<style>
	.countdown {
		text-align: center;
		margin: 6px auto 0;
	}

	.countdown-title {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 3px;
		text-transform: uppercase;
		color: var(--blue-700);
		margin-bottom: 12px;
	}

	.countdown-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 8px;
		max-width: 340px;
		margin: 0 auto;
	}

	.cd-box {
		position: relative;
		padding: 12px 4px 10px;
		border-radius: 16px;
		color: #fff;
		box-shadow: 0 8px 18px rgba(11, 31, 77, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.35);
		overflow: hidden;
	}

	.cd-box::after {
		content: '';
		position: absolute;
		inset: 3px;
		border-radius: 13px;
		border: 1px solid rgba(246, 215, 122, 0.55);
		pointer-events: none;
	}

	.cd-blue { background: linear-gradient(160deg, var(--blue-600), var(--blue-800)); }
	.cd-red { background: linear-gradient(160deg, var(--red-400), var(--red-700)); }
	.cd-green { background: linear-gradient(160deg, var(--green-400), var(--green-700)); }

	.cd-val {
		display: block;
		font-family: var(--font-deco);
		font-weight: 700;
		font-size: 26px;
		line-height: 1.1;
		font-variant-numeric: tabular-nums;
	}

	.cd-val.tick {
		animation: tick 0.45s var(--ease-spring);
	}

	.cd-label {
		display: block;
		margin-top: 2px;
		font-size: 9.5px;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		opacity: 0.9;
	}

	.countdown-done {
		margin-top: 12px;
		font-family: var(--font-script);
		font-size: 34px;
		color: var(--red-600);
	}

	@keyframes tick {
		0% { transform: translateY(-6px) scale(1.15); opacity: 0.4; }
		100% { transform: none; opacity: 1; }
	}
</style>

<script>
	const el = document.getElementById('countdown');
	if (el) {
		const target = new Date(el.dataset.target ?? '').getTime();
		const vals = Object.fromEntries(
			Array.from(el.querySelectorAll<HTMLElement>('.cd-val')).map((v) => [v.dataset.unit, v])
		);
		const done = el.querySelector<HTMLElement>('.countdown-done');
		const pad = (n: number) => String(n).padStart(2, '0');

		const set = (unit: string, value: string) => {
			const node = vals[unit];
			if (!node || node.textContent === value) return;
			node.textContent = value;
			node.classList.remove('tick');
			void node.offsetWidth;
			node.classList.add('tick');
		};

		let timer = 0;
		const update = () => {
			const diff = target - Date.now();
			if (diff <= 0) {
				['days', 'hours', 'minutes', 'seconds'].forEach((u) => set(u, '00'));
				if (done) done.hidden = false;
				window.clearInterval(timer);
				return;
			}
			set('days', pad(Math.floor(diff / 86400000)));
			set('hours', pad(Math.floor((diff / 3600000) % 24)));
			set('minutes', pad(Math.floor((diff / 60000) % 60)));
			set('seconds', pad(Math.floor((diff / 1000) % 60)));
		};

		update();
		timer = window.setInterval(update, 1000);
	}
</script>

---
// Grass.astro — franja de césped animado (briznas que se mecen, florecitas y manzanitas)
interface Props {
	variant?: 'day' | 'night';
	flowers?: boolean;
}

const { variant = 'day', flowers = true } = Astro.props;

const palette =
	variant === 'day'
		? ['#1f6638', '#2e8b4f', '#3fa463', '#5fbf7d', '#2a7a45']
		: ['#0e3b22', '#14502e', '#1b5f37', '#123f27'];
const ground = variant === 'day' ? '#2e8b4f' : '#0e3b22';

// Briznas deterministas repartidas en 3 capas que se mecen a distinto ritmo
const W = 400;
const blades = Array.from({ length: 150 }, (_, i) => {
	const x = (i * 2.7 + ((i * 7) % 5)) % W;
	const h = 26 + ((i * 13) % 36);
	const lean = (((i * 11) % 9) - 4) * 1.6;
	const w = 3 + ((i * 5) % 3);
	return {
		layer: i % 3,
		color: palette[(i * 3) % palette.length],
		d: `M${x - w} 80 Q${x + lean * 0.4} ${80 - h * 0.55} ${x + lean} ${80 - h} Q${x + lean * 0.3 + 1} ${80 - h * 0.5} ${x + w} 80Z`,
	};
});

const blooms = flowers
	? [
			{ x: 30, y: 22, c: '#ffffff' },
			{ x: 96, y: 16, c: '#e8505c' },
			{ x: 150, y: 26, c: '#cfe0fb' },
			{ x: 236, y: 18, c: '#ffffff' },
			{ x: 300, y: 24, c: '#e8505c' },
			{ x: 366, y: 20, c: '#cfe0fb' },
		]
	: [];
const apples = flowers && variant === 'day' ? [{ x: 64, y: 44 }, { x: 330, y: 46 }] : [];
---

<div class={`grass grass-${variant}`} aria-hidden="true">
	<svg viewBox="0 0 400 80" preserveAspectRatio="none" width="100%" height="100%">
		{[0, 1, 2].map((layer) => (
			<g class={`blades blades-${layer}`}>
				{blades.filter((b) => b.layer === layer).map((b) => <path d={b.d} fill={b.color} />)}
			</g>
		))}
		<rect x="0" y="70" width="400" height="10" fill={ground} />
	</svg>
	{blooms.map((f, i) => (
		<span class="bloom" style={`left:${(f.x / 400) * 100}%;bottom:${f.y}px;--c:${f.c};animation-delay:${i * 0.35}s`}></span>
	))}
	{apples.map((a, i) => (
		<svg class="grass-apple" style={`left:${(a.x / 400) * 100}%;animation-delay:${i * 1.1}s`} width="18" height="18" viewBox="0 0 32 32">
			<path d="M16 9c-2.6-2.3-9-2.6-10.6 3.2-1.4 5.2 1.6 12.6 6 14.6 1.8.8 3 .2 4.6-.4 1.6.6 2.8 1.2 4.6.4 4.4-2 7.4-9.4 6-14.6C25 6.4 18.6 6.7 16 9z" fill="#c62032" />
			<path d="M16 9.2c.2-2.4 1-4.4 2.4-6" stroke="#6b4423" stroke-width="1.8" stroke-linecap="round" fill="none" />
			<path d="M17.4 6.2c1.6-2.6 4.8-3.4 7.4-2.4-1.2 2.8-4.4 3.8-7.4 2.4z" fill="#2e8b4f" />
		</svg>
	))}
</div>

<style>
	.grass {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -1px;
		height: 84px;
		pointer-events: none;
		z-index: 3;
	}

	.grass svg:first-child {
		display: block;
	}

	.blades {
		transform-box: fill-box;
		transform-origin: 50% 100%;
		animation: sway 4.5s ease-in-out infinite;
	}

	.blades-1 {
		animation-duration: 5.5s;
		animation-delay: -1.5s;
	}

	.blades-2 {
		animation-duration: 3.8s;
		animation-delay: -2.4s;
	}

	.bloom {
		position: absolute;
		width: 9px;
		height: 9px;
		margin-left: -4.5px;
		border-radius: 50%;
		background: radial-gradient(circle, #f6d77a 0 28%, var(--c) 30%);
		box-shadow: 0 0 0 1.5px rgba(0, 0, 0, 0.06);
		animation: bloom-bob 3s ease-in-out infinite;
	}

	.grass-night .bloom {
		box-shadow: 0 0 8px var(--c);
		opacity: 0.85;
	}

	.grass-apple {
		position: absolute;
		bottom: 8px;
		margin-left: -9px;
		filter: drop-shadow(0 2px 2px rgba(0, 0, 0, 0.25));
		animation: apple-roll 4s ease-in-out infinite;
	}

	@keyframes sway {
		0%, 100% { transform: skewX(0deg); }
		50% { transform: skewX(-4deg); }
	}

	@keyframes bloom-bob {
		0%, 100% { transform: translateY(0) scale(1); }
		50% { transform: translateY(-3px) scale(1.12); }
	}

	@keyframes apple-roll {
		0%, 100% { transform: rotate(-8deg); }
		50% { transform: rotate(8deg) translateY(-2px); }
	}
</style>

---
// Ornament.astro — pequeños adornos SVG de cuento (manzana, destello, hoja, corona, separador)
interface Props {
	variant: 'apple' | 'sparkle' | 'leaf' | 'crown' | 'divider' | 'bird';
	size?: number;
	class?: string;
	style?: string;
}

const { variant, size = 24, class: className = '', style = '' } = Astro.props;
---

{variant === 'apple' && (
	<svg class={`orn orn-apple ${className}`} style={style} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
		<path d="M16 9c-2.6-2.3-9-2.6-10.6 3.2-1.4 5.2 1.6 12.6 6 14.6 1.8.8 3 .2 4.6-.4 1.6.6 2.8 1.2 4.6.4 4.4-2 7.4-9.4 6-14.6C25 6.4 18.6 6.7 16 9z" fill="#c62032" />
		<path d="M10.5 11.5c-1.6 1.2-2.4 3.2-2.2 5.2" stroke="#ff8a8f" stroke-width="1.6" stroke-linecap="round" fill="none" opacity=".8" />
		<path d="M16 9.2c.2-2.4 1-4.4 2.4-6" stroke="#6b4423" stroke-width="1.8" stroke-linecap="round" fill="none" />
		<path d="M17.4 6.2c1.6-2.6 4.8-3.4 7.4-2.4-1.2 2.8-4.4 3.8-7.4 2.4z" fill="#2e8b4f" />
	</svg>
)}

{variant === 'sparkle' && (
	<svg class={`orn orn-sparkle ${className}`} style={style} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
		<path d="M12 0c.9 6.4 5.1 10.8 12 12-6.9 1.2-11.1 5.6-12 12-.9-6.4-5.1-10.8-12-12C6.9 10.8 11.1 6.4 12 0z" fill="currentColor" />
	</svg>
)}

{variant === 'leaf' && (
	<svg class={`orn orn-leaf ${className}`} style={style} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true">
		<path d="M4 20C4 9 11 3 21 3c0 10-6 17-17 17z" fill="#2e8b4f" />
		<path d="M4 20 15 9" stroke="#1f6638" stroke-width="1.4" stroke-linecap="round" />
	</svg>
)}

{variant === 'crown' && (
	<svg class={`orn orn-crown ${className}`} style={style} width={size} height={size * 0.7} viewBox="0 0 40 28" aria-hidden="true">
		<defs>
			<linearGradient id="crownGold" x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#b98220" />
				<stop offset=".5" stop-color="#f6d77a" />
				<stop offset="1" stop-color="#c99128" />
			</linearGradient>
		</defs>
		<path d="M3 24 1 6l10 8 9-12 9 12 10-8-2 18z" fill="url(#crownGold)" stroke="#a8781c" stroke-width="1" />
		<rect x="3" y="23" width="34" height="4" rx="1.5" fill="url(#crownGold)" stroke="#a8781c" stroke-width="1" />
		<circle cx="20" cy="17" r="3" fill="#c62032" />
		<circle cx="10" cy="19" r="2" fill="#2a5cc2" />
		<circle cx="30" cy="19" r="2" fill="#2e8b4f" />
	</svg>
)}

{variant === 'bird' && (
	<svg class={`orn orn-bird ${className}`} style={style} width={size} height={size} viewBox="0 0 40 32" aria-hidden="true">
		<g class="bird-body">
			<ellipse cx="18" cy="19" rx="11" ry="8.5" fill="#3b74d6" />
			<circle cx="27" cy="12" r="6.5" fill="#3b74d6" />
			<ellipse cx="19" cy="22" rx="7" ry="4.5" fill="#cfe0fb" />
			<circle cx="29" cy="11" r="1.6" fill="#0b1f4d" />
			<circle cx="29.5" cy="10.5" r=".5" fill="#fff" />
			<path d="M33 13l5 1.2-5 1.6z" fill="#f2a516" />
			<path d="M8 17 1 13l3 7z" fill="#1d47a1" />
		</g>
		<path class="bird-wing" d="M14 16c3-6 9-7 11-5-2 5-6 8-11 5z" fill="#1d47a1" />
	</svg>
)}

{variant === 'divider' && (
	<div class={`orn-divider ${className}`} style={style} aria-hidden="true">
		<span class="orn-line"></span>
		<svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 0c.9 6.4 5.1 10.8 12 12-6.9 1.2-11.1 5.6-12 12-.9-6.4-5.1-10.8-12-12C6.9 10.8 11.1 6.4 12 0z" fill="#d9a93a" /></svg>
		<svg width="30" height="30" viewBox="0 0 32 32">
			<path d="M16 9c-2.6-2.3-9-2.6-10.6 3.2-1.4 5.2 1.6 12.6 6 14.6 1.8.8 3 .2 4.6-.4 1.6.6 2.8 1.2 4.6.4 4.4-2 7.4-9.4 6-14.6C25 6.4 18.6 6.7 16 9z" fill="#c62032" />
			<path d="M10.5 11.5c-1.6 1.2-2.4 3.2-2.2 5.2" stroke="#ff8a8f" stroke-width="1.6" stroke-linecap="round" fill="none" opacity=".8" />
			<path d="M16 9.2c.2-2.4 1-4.4 2.4-6" stroke="#6b4423" stroke-width="1.8" stroke-linecap="round" fill="none" />
			<path d="M17.4 6.2c1.6-2.6 4.8-3.4 7.4-2.4-1.2 2.8-4.4 3.8-7.4 2.4z" fill="#2e8b4f" />
		</svg>
		<svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 0c.9 6.4 5.1 10.8 12 12-6.9 1.2-11.1 5.6-12 12-.9-6.4-5.1-10.8-12-12C6.9 10.8 11.1 6.4 12 0z" fill="#d9a93a" /></svg>
		<span class="orn-line"></span>
	</div>
)}

<style>
	.orn {
		display: inline-block;
		flex-shrink: 0;
	}

	.orn-divider {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		max-width: 280px;
		margin: 0 auto;
	}

	.orn-divider svg:nth-of-type(2) {
		animation: apple-bob 3.2s ease-in-out infinite;
	}

	.orn-divider svg:nth-of-type(1),
	.orn-divider svg:nth-of-type(3) {
		animation: twinkle 2.4s ease-in-out infinite;
	}

	.orn-divider svg:nth-of-type(3) {
		animation-delay: 1.2s;
	}

	.orn-line {
		flex: 1;
		height: 1.5px;
		background: linear-gradient(90deg, transparent, var(--gold), transparent);
	}

	.orn-bird .bird-wing {
		transform-origin: 16px 16px;
		animation: flap 0.5s ease-in-out infinite alternate;
	}

	@keyframes flap {
		from { transform: rotate(0deg); }
		to { transform: rotate(-28deg); }
	}

	@keyframes apple-bob {
		0%, 100% { transform: translateY(0) rotate(-6deg); }
		50% { transform: translateY(-4px) rotate(6deg); }
	}

	@keyframes twinkle {
		0%, 100% { transform: scale(0.7) rotate(0deg); opacity: 0.6; }
		50% { transform: scale(1.1) rotate(45deg); opacity: 1; }
	}
</style>

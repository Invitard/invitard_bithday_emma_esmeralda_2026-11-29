---
// RsvpSection.astro — confirmación por WhatsApp con Alisson
const phone = '51949155127';
---

<form class="rsvp" id="rsvp-form" data-phone={phone}>
	<label class="rsvp-field">
		<span class="rsvp-label">Tu nombre</span>
		<input type="text" name="name" id="rsvp-name" autocomplete="name" placeholder="Ej.: María Pérez" maxlength="60" />
	</label>


	<button type="submit" class="btn-whatsapp">
		<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
			<path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1s.9 2.44 1.03 2.61c.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.17-.48-.29z" />
		</svg>
		<span>Confirmar por WhatsApp</span>
	</button>

	<p class="rsvp-contact">
		Confirma con <strong>Alisson</strong> ·
		<a href={`tel:+${phone}`}>+51 949 155 127</a>
	</p>
</form>

<style>
	.rsvp {
		max-width: 340px;
		margin: 0 auto;
		display: flex;
		flex-direction: column;
		gap: 14px;
		text-align: left;
	}

	.rsvp-field {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.rsvp-label {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.6px;
		color: var(--blue-100);
	}

	.rsvp input {
		width: 100%;
		padding: 13px 16px;
		border-radius: 14px;
		border: 1.5px solid rgba(246, 215, 122, 0.5);
		background: rgba(255, 255, 255, 0.96);
		font: 500 15px var(--font-body);
		color: var(--ink);
		transition: border-color 0.2s, box-shadow 0.2s;
	}

	.rsvp input:focus {
		outline: none;
		border-color: var(--gold);
		box-shadow: 0 0 0 4px rgba(217, 169, 58, 0.3);
	}

	.btn-whatsapp {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		width: 100%;
		margin-top: 4px;
		padding: 15px 20px;
		border-radius: 999px;
		background: linear-gradient(135deg, var(--green-400), var(--green-700));
		color: #fff;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 1px;
		text-transform: uppercase;
		box-shadow: 0 10px 22px rgba(31, 102, 56, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.35);
		animation: wa-pulse 2.6s ease-in-out infinite;
		transition: transform 0.25s var(--ease-spring);
	}

	.btn-whatsapp:hover {
		transform: translateY(-2px) scale(1.02);
	}

	.rsvp-contact {
		text-align: center;
		font-size: 12px;
		color: var(--blue-100);
	}

	.rsvp-contact strong {
		color: #fff;
	}

	.rsvp-contact a {
		color: #f6d77a;
		font-weight: 600;
		white-space: nowrap;
	}

	@keyframes wa-pulse {
		0%, 100% { box-shadow: 0 10px 22px rgba(31, 102, 56, 0.45), 0 0 0 0 rgba(95, 191, 125, 0.55); }
		50% { box-shadow: 0 10px 22px rgba(31, 102, 56, 0.45), 0 0 0 10px rgba(95, 191, 125, 0); }
	}
</style>

<script>
	const form = document.getElementById('rsvp-form') as HTMLFormElement | null;
	const nameInput = document.getElementById('rsvp-name') as HTMLInputElement | null;

	if (form && nameInput) {
		form.addEventListener('submit', (e) => {
			e.preventDefault();
			const name = nameInput.value.trim();
			const who = name ? `Soy ${name} y con` : 'Con';
			const msg =
				`¡Hola Alisson! 🍎✨ ${who} mucha alegría confirmo mi asistencia al cumpleaños de Emma Esmeralda ` +
				`(2 añitos) el domingo 29 de noviembre a las 4:00 p.m. en Crystal Palace Cusco. 👑`;
			window.open(`https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
		});
	}
</script>

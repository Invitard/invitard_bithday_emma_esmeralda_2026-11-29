---
// Calendar.astro — noviembre 2026 con el día 29 marcado por una manzana mágica
const year = 2026;
const month = 10; // noviembre (0-indexado)
const highlight = 29;

const firstWeekday = (new Date(Date.UTC(year, month, 1)).getUTCDay() + 6) % 7; // lunes = 0
const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
const cells: (number | null)[] = [
	...Array.from({ length: firstWeekday }, () => null),
	...Array.from({ length: daysInMonth }, (_, i) => i + 1),
];
const weekdays = ['L', 'M', 'M', 'J', 'V', 'S', 'D'];
---

<div class="calendar" aria-label="Calendario de noviembre de 2026, domingo 29 marcado">
	<div class="cal-head">
		<span class="cal-month">Noviembre</span>
		<span class="cal-year">2026</span>
	</div>
	<div class="cal-grid">
		{weekdays.map((d, i) => <span class={`cal-wd ${i === 6 ? 'is-sun' : ''}`}>{d}</span>)}
		{cells.map((day) =>
			day === null ? (
				<span class="cal-empty" />
			) : day === highlight ? (
				<span class="cal-day is-party" aria-label="Domingo 29: ¡la fiesta!">
					<svg class="cal-apple" viewBox="0 0 32 32" aria-hidden="true">
						<path d="M16 9c-2.6-2.3-9-2.6-10.6 3.2-1.4 5.2 1.6 12.6 6 14.6 1.8.8 3 .2 4.6-.4 1.6.6 2.8 1.2 4.6.4 4.4-2 7.4-9.4 6-14.6C25 6.4 18.6 6.7 16 9z" fill="#c62032" />
						<path d="M16 9.2c.2-2.4 1-4.4 2.4-6" stroke="#6b4423" stroke-width="1.8" stroke-linecap="round" fill="none" />
						<path d="M17.4 6.2c1.6-2.6 4.8-3.4 7.4-2.4-1.2 2.8-4.4 3.8-7.4 2.4z" fill="#2e8b4f" />
					</svg>
					<span class="cal-num">{day}</span>
				</span>
			) : (
				<span class="cal-day">{day}</span>
			)
		)}
	</div>
</div>

<style>
	.calendar {
		max-width: 320px;
		margin: 0 auto;
		padding: 16px 14px 14px;
		background: #fff;
		border-radius: 20px;
		border: 1.5px solid var(--blue-200);
		border-bottom: 5px solid var(--green-600);
		box-shadow: 0 10px 24px rgba(29, 71, 161, 0.12);
	}

	.cal-head {
		display: flex;
		align-items: baseline;
		justify-content: center;
		gap: 8px;
		margin-bottom: 10px;
	}

	.cal-month {
		font-family: var(--font-script);
		font-size: 34px;
		line-height: 1;
		color: var(--blue-700);
	}

	.cal-year {
		font-family: var(--font-deco);
		font-size: 13px;
		font-weight: 700;
		color: var(--green-700);
	}

	.cal-grid {
		display: grid;
		grid-template-columns: repeat(7, 1fr);
		gap: 4px;
		text-align: center;
	}

	.cal-wd {
		font-size: 10px;
		font-weight: 700;
		color: var(--green-600);
		padding-bottom: 4px;
	}

	.cal-wd.is-sun {
		color: var(--red-600);
	}

	.cal-day {
		position: relative;
		display: grid;
		place-items: center;
		height: 32px;
		font-size: 12.5px;
		font-weight: 500;
		color: var(--ink-soft);
		border-radius: 50%;
	}

	.cal-day.is-party {
		color: #fff;
		font-weight: 700;
	}

	.cal-apple {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 40px;
		height: 40px;
		margin: -21px 0 0 -20px;
		filter: drop-shadow(0 3px 5px rgba(154, 20, 36, 0.4));
		animation: party-apple 2.4s var(--ease-spring) infinite;
	}

	.cal-num {
		position: relative;
		margin-top: 3px;
	}

	@keyframes party-apple {
		0%, 100% { transform: scale(1) rotate(0deg); }
		15% { transform: scale(1.18) rotate(-8deg); }
		30% { transform: scale(1) rotate(6deg); }
		45% { transform: scale(1.05) rotate(0deg); }
	}
</style>

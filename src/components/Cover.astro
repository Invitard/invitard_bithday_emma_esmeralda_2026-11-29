---
// Cover.astro — portada: el libro de cuentos que se abre al tocarlo
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const stars = Array.from({ length: 28 }, (_, i) => ({
	x: (i * 37 + 11) % 100,
	y: (i * 53 + 7) % 100,
	s: 6 + ((i * 7) % 10),
	d: ((i * 0.37) % 3).toFixed(2),
}));
---

<div class="cover" id="story-cover" role="dialog" aria-modal="true" aria-label="Portada del cuento de Emma Esmeralda">
	<div class="cover-stars" aria-hidden="true">
		{stars.map((st) => (
			<svg class="cover-star" style={`left:${st.x}%;top:${st.y}%;width:${st.s}px;height:${st.s}px;animation-delay:${st.d}s`} viewBox="0 0 24 24">
				<path d="M12 0c.9 6.4 5.1 10.8 12 12-6.9 1.2-11.1 5.6-12 12-.9-6.4-5.1-10.8-12-12C6.9 10.8 11.1 6.4 12 0z" fill="currentColor" />
			</svg>
		))}
	</div>

	<div class="cover-content">
		<p class="cover-kicker">Un cuento de hadas</p>
		<h1 class="cover-title">Emma Esmeralda</h1>
		<p class="cover-sub">y su reino encantado</p>

		<button class="book" id="open-book" aria-label="Abrir el cuento">
			<span class="book-glow" aria-hidden="true"></span>
			<span class="book-page" aria-hidden="true">
				<span class="book-page-text">Había<br />una vez…</span>
			</span>
			<img class="book-cover" src={`${base}/img/elements/libro.webp`} alt="Libro de cuentos con la silueta dorada de una princesita" width="800" height="1120" />
		</button>

		<button class="cover-hint" id="open-book-hint" type="button" aria-label="Abrir el cuento">
			<svg class="hint-arrow" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="M12 19V5M5 12l7-7 7 7" />
			</svg>
			<span class="hint-icon" aria-hidden="true">
				<span class="hint-ripple"></span>
				<svg class="hint-hand" width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
					<path d="M9 11.24V7.5a2.5 2.5 0 0 1 5 0v3.74c1.21-.81 2-2.18 2-3.74C16 5.01 13.99 3 11.5 3S7 5.01 7 7.5c0 1.56.79 2.93 2 3.74zm9.84 4.63-4.54-2.26a1.3 1.3 0 0 0-.54-.11H13v-6a1.5 1.5 0 0 0-3 0v10.74l-3.43-.72a1.04 1.04 0 0 0-.98.29l-.79.8 4.94 4.94c.27.27.65.44 1.06.44h6.79c.75 0 1.33-.55 1.44-1.28l.75-5.27c.01-.07.02-.14.02-.2 0-.62-.38-1.16-.96-1.37z" />
				</svg>
			</span>
			<span class="hint-text">
				<strong>¡Toca el libro!</strong>
				<span>para abrir el cuento</span>
			</span>
		</button>
	</div>
</div>

<style>
	.cover {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: grid;
		place-items: center;
		overflow: hidden;
		background:
			radial-gradient(ellipse at 50% 55%, rgba(42, 92, 194, 0.55) 0%, transparent 60%),
			radial-gradient(ellipse at 50% 0%, #1d3f8f 0%, #0b1f4d 55%, #071638 100%);
		transition: opacity 0.9s ease, visibility 0s linear 0.9s;
	}

	.cover.is-open {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.cover-stars {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.cover-star {
		position: absolute;
		color: #f6d77a;
		animation: star-twinkle 2.8s ease-in-out infinite;
	}

	@keyframes star-twinkle {
		0%, 100% { opacity: 0.15; transform: scale(0.6) rotate(0deg); }
		50% { opacity: 1; transform: scale(1) rotate(30deg); }
	}

	.cover-content {
		position: relative;
		text-align: center;
		padding: 24px 16px;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.cover-kicker {
		font-family: var(--font-body);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 4px;
		text-transform: uppercase;
		color: var(--blue-200);
		animation: fade-down 1s var(--ease-out) both;
	}

	.cover-title {
		font-family: var(--font-script);
		font-weight: 400;
		font-size: clamp(46px, 13vw, 64px);
		line-height: 1.1;
		background: var(--gold-gradient);
		background-size: 200% 100%;
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		filter: drop-shadow(0 2px 8px rgba(246, 215, 122, 0.35));
		animation: fade-down 1s var(--ease-out) 0.15s both, shimmer 4s linear infinite;
	}

	.cover-sub {
		font-family: var(--font-story);
		font-style: italic;
		font-size: 18px;
		color: var(--blue-100);
		margin-bottom: 18px;
		animation: fade-down 1s var(--ease-out) 0.3s both;
	}

	.book {
		position: relative;
		width: min(62vw, 250px);
		aspect-ratio: 800 / 1120;
		perspective: 1400px;
		animation: book-float 4s ease-in-out infinite, book-in 1.2s var(--ease-spring) 0.4s both;
		transition: transform 0.9s var(--ease-out);
	}

	.book-glow {
		position: absolute;
		inset: -18%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(246, 215, 122, 0.55) 0%, rgba(107, 155, 230, 0.25) 40%, transparent 70%);
		animation: glow-pulse 2.6s ease-in-out infinite;
		pointer-events: none;
	}

	.book-page {
		position: absolute;
		left: 10%;
		right: 8%;
		top: 8%;
		bottom: 4%;
		border-radius: 4px 10px 10px 4px;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.12), transparent 12%),
			#fffdf6;
		display: grid;
		place-items: center;
		box-shadow: inset 0 0 30px rgba(168, 120, 28, 0.25);
	}

	.book-page-text {
		font-family: var(--font-script);
		font-size: clamp(30px, 9vw, 40px);
		line-height: 1.1;
		color: var(--blue-700);
		opacity: 0;
		transition: opacity 0.6s ease 0.5s;
	}

	.book-cover {
		position: relative;
		width: 100%;
		height: 100%;
		object-fit: contain;
		transform-origin: 9% 50%;
		backface-visibility: hidden;
		transition: transform 1.3s cubic-bezier(0.6, 0, 0.2, 1);
		filter: drop-shadow(0 18px 30px rgba(0, 0, 0, 0.45));
	}

	.book:hover .book-cover {
		transform: rotateY(-12deg);
	}

	.cover.is-opening .book {
		animation: none;
		transform: scale(1.12);
	}

	.cover.is-opening .book-cover {
		transform: rotateY(-165deg);
	}

	.cover.is-opening .book-page-text {
		opacity: 1;
	}

	.cover-hint {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 14px;
		margin-top: 34px;
		padding: 14px 26px 14px 14px;
		min-height: 64px;
		border-radius: 999px;
		background: linear-gradient(135deg, #fff6d6 0%, #f6d77a 45%, #e2b34a 100%);
		border: 2px solid rgba(255, 255, 255, 0.85);
		box-shadow:
			0 0 0 4px rgba(246, 215, 122, 0.25),
			0 10px 28px rgba(0, 0, 0, 0.35),
			0 0 30px rgba(246, 215, 122, 0.45);
		color: var(--blue-700);
		text-align: left;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		animation: fade-up 1s var(--ease-out) 1s both, hint-pulse 2s ease-in-out 2s infinite;
	}

	.cover-hint:active {
		transform: scale(0.96);
	}

	.hint-arrow {
		position: absolute;
		top: -30px;
		left: 50%;
		margin-left: -11px;
		color: #f6d77a;
		filter: drop-shadow(0 0 6px rgba(246, 215, 122, 0.7));
		animation: arrow-bounce 1.2s ease-in-out infinite;
	}

	.hint-icon {
		position: relative;
		flex: none;
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--blue-700);
		color: #fff;
	}

	.hint-ripple {
		position: absolute;
		inset: 0;
		border-radius: 50%;
		box-shadow: 0 0 0 0 rgba(232, 80, 92, 0.7);
		animation: hint-ping 1.6s ease-out infinite;
	}

	.hint-hand {
		width: 26px;
		height: 26px;
		animation: hand-tap 1.6s ease-in-out infinite;
	}

	.hint-text {
		display: flex;
		flex-direction: column;
		line-height: 1.15;
	}

	.hint-text strong {
		font-family: var(--font-story);
		font-size: clamp(19px, 5.4vw, 22px);
		font-weight: 700;
	}

	.hint-text span {
		font-size: 14px;
		font-weight: 500;
		opacity: 0.85;
	}

	.cover.is-opening .cover-hint {
		opacity: 0;
		transform: scale(0.9);
		transition: opacity 0.4s ease, transform 0.4s ease;
		animation: none;
		pointer-events: none;
	}

	@keyframes hint-pulse {
		0%, 100% { transform: scale(1); }
		50% { transform: scale(1.06); }
	}

	@keyframes arrow-bounce {
		0%, 100% { transform: translateY(0); opacity: 0.7; }
		50% { transform: translateY(-8px); opacity: 1; }
	}

	@keyframes hand-tap {
		0%, 100% { transform: translateY(0) scale(1); }
		40% { transform: translateY(-3px) scale(1.05); }
		55% { transform: translateY(2px) scale(0.92); }
	}

	@media (prefers-reduced-motion: reduce) {
		.cover-hint,
		.hint-arrow,
		.hint-hand,
		.hint-ripple {
			animation: none;
		}
	}

	@keyframes book-float {
		0%, 100% { transform: translateY(0) rotate(-1.5deg); }
		50% { transform: translateY(-10px) rotate(1.5deg); }
	}

	@keyframes book-in {
		from { opacity: 0; transform: translateY(40px) scale(0.8); }
		to { opacity: 1; transform: none; }
	}

	@keyframes glow-pulse {
		0%, 100% { opacity: 0.6; transform: scale(0.95); }
		50% { opacity: 1; transform: scale(1.05); }
	}

	@keyframes hint-ping {
		to { box-shadow: 0 0 0 12px rgba(232, 80, 92, 0); }
	}

	@keyframes fade-down {
		from { opacity: 0; transform: translateY(-14px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes fade-up {
		from { opacity: 0; transform: translateY(14px); }
		to { opacity: 1; transform: none; }
	}

	@keyframes shimmer {
		from { background-position: 200% 0; }
		to { background-position: -200% 0; }
	}
</style>

<script>
	const cover = document.getElementById('story-cover');
	const book = document.getElementById('open-book');
	const hint = document.getElementById('open-book-hint');

	if (cover && book) {
		document.body.classList.add('is-locked');

		const open = () => {
			if (cover.classList.contains('is-opening')) return;
			cover.classList.add('is-opening');
			// Dentro del gesto del usuario para que el navegador permita la música
			document.dispatchEvent(new CustomEvent('story:opening'));
			// El libro queda abierto 3 segundos y luego se desvanece
			window.setTimeout(() => cover.classList.add('is-open'), 3000);
			window.setTimeout(() => {
				document.body.classList.remove('is-locked');
				document.dispatchEvent(new CustomEvent('story:open'));
			}, 3900);
		};

		book.addEventListener('click', open);
		hint?.addEventListener('click', open);
	}
</script>

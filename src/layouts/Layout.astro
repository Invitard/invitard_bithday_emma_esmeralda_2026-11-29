---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = "El cuento de Emma Esmeralda · Mis 2 añitos",
	description = "Había una vez una princesita que cumplía 2 años… Te invito a mi fiesta de Blanca Nieves el domingo 29 de noviembre de 2026 a las 4:00 p.m. en Crystal Palace, Cusco."
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogPath = `${base}/img/og-emma.jpg`;
const ogImageUrl = Astro.site ? new URL(ogPath, Astro.site).href : ogPath;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="theme-color" content="#0b1f4d" />
		<!-- Siempre tema claro: evita que el modo oscuro del navegador altere los colores -->
		<meta name="color-scheme" content="only light" />
		<meta name="supported-color-schemes" content="light" />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700;900&family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Great+Vibes&family=Montserrat:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<link rel="preload" as="image" href={`${base}/img/elements/libro.webp`} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		color-scheme: only light;

		/* Azul — color principal */
		--blue-950: #071638;
		--blue-900: #0b1f4d;
		--blue-800: #13306f;
		--blue-700: #1d47a1;
		--blue-600: #2a5cc2;
		--blue-400: #6b9be6;
		--blue-200: #cfe0fb;
		--blue-100: #e3edfd;
		--blue-50: #f3f7ff;

		/* Rojo y verde — secundarios */
		--red-700: #9a1424;
		--red-600: #c62032;
		--red-400: #e8505c;
		--green-700: #1f6638;
		--green-600: #2e8b4f;
		--green-400: #5fbf7d;
		--green-100: #def3e4;

		/* Oro de cuento (de los elementos gráficos) */
		--gold: #d9a93a;
		--gold-dark: #a8781c;
		--gold-gradient: linear-gradient(135deg, #b98220 0%, #f6d77a 45%, #fff1bf 55%, #c99128 100%);

		--ink: #1a2a4f;
		--ink-soft: #3d4f78;
		--cream: #fffdf6;

		--font-deco: 'Cinzel Decorative', 'Cormorant Garamond', serif;
		--font-script: 'Great Vibes', cursive;
		--font-story: 'Cormorant Garamond', Georgia, serif;
		--font-body: 'Montserrat', system-ui, sans-serif;

		--ease-out: cubic-bezier(0.16, 1, 0.3, 1);
		--ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		background-color: var(--blue-950);
		background-image:
			radial-gradient(1px 1px at 12% 18%, rgba(255, 255, 255, 0.7), transparent 60%),
			radial-gradient(1.5px 1.5px at 78% 12%, rgba(255, 255, 255, 0.8), transparent 60%),
			radial-gradient(1px 1px at 45% 70%, rgba(255, 255, 255, 0.6), transparent 60%),
			radial-gradient(1.5px 1.5px at 88% 82%, rgba(255, 255, 255, 0.7), transparent 60%),
			radial-gradient(1px 1px at 22% 88%, rgba(255, 255, 255, 0.6), transparent 60%),
			radial-gradient(ellipse at 50% 0%, #1d3f8f 0%, #0b1f4d 45%, #071638 100%);
		background-attachment: fixed;
		color: var(--ink);
		font-family: var(--font-body);
		-webkit-font-smoothing: antialiased;
		scroll-behavior: smooth;
	}

	body {
		min-height: 100vh;
		overflow-x: hidden;
	}

	body.is-locked {
		overflow: hidden;
		height: 100vh;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button {
		font-family: inherit;
		cursor: pointer;
		border: none;
		background: none;
		color: inherit;
	}

	img {
		max-width: 100%;
		display: block;
	}

	:focus-visible {
		outline: 3px solid var(--gold);
		outline-offset: 3px;
		border-radius: 6px;
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
